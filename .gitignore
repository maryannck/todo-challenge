cd ~/Development/todo-challenge

cat << 'EOF' > .gitignore
# Dependencies
node_modules/
.pnp
.pnp.js

# Environment secrets
.env
.env.local
.env.*.local

# SQLite databases & Prisma local files
*.db
*.db-journal
*.sqlite
dev.db
test.db

# Production & Build outputs
dist/
build/
*.tsbuildinfo

# Logs & Diagnostics
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.har
.npm/

# IDE & Editor system files
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
EOF